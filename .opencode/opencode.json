{
	"$schema": "https://opencode.ai/config.json",
	"plugin": [
		"@sveltejs/opencode"
	],
	"mcp": {
		"firefox-devtools": {
			"type": "local",
			"command": [
				"npx",
				"-y",
				"@mozilla/firefox-devtools-mcp@latest",
				"--firefox-path",
				"/Applications/Firefox Developer Edition.app/Contents/MacOS/firefox",
				"--tool-preset",
				"developer"
			],
			"enabled": true
		}
	}
}
